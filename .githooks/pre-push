#!/usr/bin/env sh
# Security scans before every push (same as CI's scan_ruby and scan_js jobs).
# Installed by bin/setup (git config core.hooksPath .githooks).
# Skip once in an emergency with: git push --no-verify
set -e

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: Brakeman"
bin/brakeman --no-pager --quiet

echo "pre-push: bundler-audit (updating advisory database)"
bin/bundler-audit check --update

echo "pre-push: importmap audit"
bin/importmap audit

echo "pre-push: security scans passed"
