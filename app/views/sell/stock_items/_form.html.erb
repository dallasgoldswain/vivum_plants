<%= form_with model: [ :sell, stock_item ], class: "form grid gap-4" do |form| %>
  <% if stock_item.errors.any? %>
    <div class="alert-destructive" role="alert">
      <h3>Couldn't save</h3>
      <section><%= stock_item.errors.full_messages.to_sentence %>.</section>
    </div>
  <% end %>

  <% if stock_item.new_record? %>
    <fieldset class="grid gap-2">
      <legend class="mb-1 text-sm font-medium">What is it?</legend>

      <label class="flex min-h-11 items-center gap-2 text-sm font-normal">
        <%= form.radio_button :kind, "batch" %>
        A batch of identical plants (e.g. 10 pots of the same cultivar)
      </label>

      <label class="flex min-h-11 items-center gap-2 text-sm font-normal">
        <%= form.radio_button :kind, "specimen" %>
        One unique plant (a specimen)
      </label>
    </fieldset>
  <% end %>

  <div class="grid gap-2">
    <%= form.label :name %>
    <%= form.text_field :name, required: true, maxlength: 120, placeholder: "e.g. Monstera Thai Constellation" %>
  </div>

  <div class="grid gap-3 sm:grid-cols-2">
    <div class="grid gap-2">
      <%= form.label :cultivar %>
      <%= form.text_field :cultivar, maxlength: 120 %>
    </div>

    <div class="grid gap-2">
      <%= form.label :botanical_name, "Botanical name" %>
      <%= form.text_field :botanical_name, maxlength: 120 %>
    </div>

    <div class="grid gap-2">
      <%= form.label :size, "Size or pot" %>
      <%= form.text_field :size, maxlength: 60, placeholder: "e.g. 12 cm pot" %>
    </div>

    <div class="grid gap-2">
      <%= form.label :code, "Code" %>
      <%= form.text_field :code, maxlength: 30, placeholder: (stock_item.new_record? ? "Leave blank for the next S- number" : nil) %>
    </div>

    <div class="grid gap-2">
      <%= form.label :price, "Price per plant (R)" %>
      <%= form.number_field :price, min: 0, step: "0.01", inputmode: "decimal" %>
    </div>

    <div class="grid gap-2">
      <%= form.label :cost, "Cost per plant (R, private)" %>
      <%= form.number_field :cost, min: 0, step: "0.01", inputmode: "decimal" %>
    </div>
  </div>

  <div class="grid gap-2">
    <%= form.label :notes %>
    <%= form.text_area :notes, rows: 3, maxlength: 2000 %>
  </div>

  <% if stock_item.new_record? %>
    <fieldset class="grid gap-3 sm:grid-cols-2">
      <legend class="mb-1 text-sm font-medium">Receive now (optional)</legend>

      <div class="grid gap-2">
        <%= label_tag :receive_quantity, "How many" %>
        <%= number_field_tag :receive_quantity, params[:receive_quantity], min: 0, step: 1 %>
      </div>

      <div class="grid gap-2">
        <%= label_tag :receive_location_id, "At" %>
        <%= select_tag :receive_location_id, options_for_select(location_options(locations), params[:receive_location_id]), include_blank: "Choose…", class: "select" %>
      </div>
    </fieldset>
  <% end %>

  <div><%= form.submit "Save", class: "btn" %></div>
<% end %>
