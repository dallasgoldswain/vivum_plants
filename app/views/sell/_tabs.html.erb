<% if Current.membership.owner? && Current.seller.free_period_ended? %>
  <div class="alert" role="status">
    <h2>Your free <%= Current.seller.billing_mode %> period has ended</h2>

    <section>
      Paid plans are coming soon. You can keep using VIVUM in the meantime, and
      we'll be in touch before anything changes.
    </section>
  </div>
<% end %>

<nav class="flex gap-2" aria-label="Sell">
  <%= nav_link_to "Overview", sell_root_path, class: "btn-sm-ghost aria-[current=page]:bg-surface" %>

  <% if capability?("seller.stock") %>
    <%= nav_link_to "Stock", sell_stock_items_path, class: "btn-sm-ghost aria-[current=page]:bg-surface" %>
  <% end %>

  <% if capability?("seller.listings") && Current.membership.manager_or_owner? %>
    <%= nav_link_to "Listings", sell_listings_path, class: "btn-sm-ghost aria-[current=page]:bg-surface" %>
  <% end %>

  <% if capability?("seller.buyers") %>
    <%= nav_link_to "Buyers", sell_buyers_path, class: "btn-sm-ghost aria-[current=page]:bg-surface" %>
  <% end %>

  <% if capability?("seller.members") %>
    <%= nav_link_to "Members", sell_members_path, class: "btn-sm-ghost aria-[current=page]:bg-surface" %>
  <% end %>
</nav>
