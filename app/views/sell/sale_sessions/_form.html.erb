<%= form_with model: sale_session, url: sale_session.persisted? ? sell_sale_session_path(sale_session) : sell_sale_sessions_path, class: "form grid gap-4" do |form| %>
  <% if sale_session.errors.any? %>
    <div class="alert-destructive" role="alert">
      <h3>Couldn't save the session</h3>
      <section><%= sale_session.errors.full_messages.to_sentence %>.</section>
    </div>
  <% end %>

  <div class="grid gap-2">
    <%= form.label :name %>
    <%= form.text_field :name, required: true, maxlength: 80, placeholder: "e.g. Sunday aroid auction" %>
  </div>

  <div class="grid gap-2">
    <%= form.label :channel, "Group or channel (optional)" %>
    <%= form.text_field :channel, maxlength: 80, placeholder: "e.g. Aroid Club SA" %>

    <p class="vv-caption">
      New names the host types become aliases in this group.
    </p>
  </div>

  <div class="grid gap-2">
    <%= form.label :host_member_id, "Host" %>
    <%= form.select :host_member_id, host_options(Current.seller), { include_blank: "No host yet" }, class: "select" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid gap-2">
      <%= form.label :starts_at, "Starts (optional)" %>
      <%= form.datetime_local_field :starts_at %>
    </div>

    <div class="grid gap-2">
      <%= form.label :closes_at, "Closes (optional)" %>
      <%= form.datetime_local_field :closes_at %>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid gap-2">
      <%= form.label :payment_hours, "Payment deadline (hours)" %>
      <%= form.number_field :payment_hours, min: 1, max: SaleSession::MAX_HOURS, step: 1 %>

      <p class="vv-caption">
        How long a winner or claimer has to pay, from when they win or claim.
      </p>
    </div>

    <div class="grid gap-2">
      <%= form.label :backup_hours, "Backup window (hours)" %>
      <%= form.number_field :backup_hours, min: 1, max: SaleSession::MAX_HOURS, step: 1 %>

      <p class="vv-caption">
        How long the plant stays held after a missed payment, so you can offer
        it to the backup bidder.
      </p>
    </div>
  </div>

  <p class="vv-caption">
    Both timings are needed before the session can go live. There's no default.
  </p>

  <div>
    <%= form.submit sale_session.persisted? ? "Save" : "Set up session", class: "btn" %>
  </div>
<% end %>
