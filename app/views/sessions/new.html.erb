<% content_for :title, "Sign in · VIVUM Plants" %>

<div>
  <p class="vv-kicker mb-2">Welcome back</p>
  <h2 class="vv-h2">Sign in</h2>
</div>

<div class="card card-raised">
  <section>
    <%= form_with url: session_path, class: "form grid gap-6" do |form| %>
      <div class="grid gap-2">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
      </div>

      <div class="grid gap-2">
        <%= form.label :password %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
      </div>

      <%= form.submit "Sign in", class: "btn w-full" %>
    <% end %>
  </section>
</div>

<div class="grid gap-2 text-center text-sm">
  <%= link_to "Forgot your password?", new_password_path, class: "text-forest underline-offset-4 hover:underline" %>

  <p class="text-fg2">
    New to VIVUM?
    <%= link_to "Create an account", new_registration_path, class: "text-forest underline-offset-4 hover:underline" %>
  </p>
</div>
