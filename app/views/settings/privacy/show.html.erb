<% content_for :title, "Privacy · VIVUM Plants" %>

<div>
  <p class="vv-kicker mb-2">Settings</p>

  <div class="flex items-start justify-between gap-3">
    <h1 class="vv-h2">Privacy</h1>
    <%= help_link "privacy" %>
  </div>

  <p class="vv-caption mt-1">
    What you've agreed to, and a record of every change. Turning something off
    takes effect straight away.
  </p>
</div>

<div class="card">
  <header>
    <h2>Your choices</h2>
  </header>

  <section>
    <ul class="grid gap-3">
      <% @purposes.each do |purpose| %>
        <% record = @current[purpose.key] %>
        <% on = record&.in_force? %>

        <li
          class="
            flex flex-col gap-3 rounded-[4px] border border-line bg-linen px-4
            py-3 sm:flex-row sm:items-center sm:justify-between
          "
        >
          <div class="grid gap-1">
            <p class="font-medium">
              <% if purpose.required %>
                <%= link_to purpose.label, legal_document_path(purpose.key), class: "text-forest underline-offset-4 hover:underline" %>
              <% else %>
                <%= purpose.label %>
              <% end %>

              <span class="<%= on ? "badge-secondary" : "badge-outline" %> ml-2">
                <%= purpose.required ? "Accepted" : (on ? "On" : "Off") %>
              </span>
            </p>

            <p class="vv-caption"><%= purpose.description %></p>

            <% if record %>
              <p class="vv-caption">
                <%= record.granted? ? "Agreed to" : "Turned off" %> version
                <%= record.version %> on
                <%= l record.created_at, format: :long %>.
              </p>
            <% end %>
          </div>

          <% if purpose.required %>
            <p class="vv-caption sm:max-w-48">
              Required to use VIVUM. To withdraw,
              <%= link_to "delete your account", settings_account_path, class: "text-forest underline-offset-4 hover:underline" %>.
            </p>
          <% else %>
            <%= button_to on ? "Turn off" : "Turn on", settings_consent_path(purpose.key), method: :patch, params: { granted: on ? "0" : "1" }, class: on ? "btn-outline" : "btn" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</div>

<div class="card">
  <header>
    <h2>History</h2>
    <p>Each time you agreed or changed your mind, with where it happened.</p>
  </header>

  <section class="overflow-x-auto">
    <% if @history.any? %>
      <table class="table">
        <thead>
          <tr>
            <th>When</th>
            <th>What</th>
            <th>Choice</th>
            <th>Where</th>
          </tr>
        </thead>

        <tbody>
          <% @history.each do |record| %>
            <tr>
              <td class="whitespace-nowrap">
                <%= l record.created_at, format: :short %>
              </td>

              <td>
                <%= record.purpose_definition&.label || record.purpose %>
                <span class="vv-caption">v<%= record.version %></span>
              </td>

              <td><%= record.granted? ? "Agreed" : "Withdrew" %></td>

              <td>
                <%= record.source.humanize %>

                <% if record.ip_address %>
                  <span class="vv-caption">· <%= record.ip_address %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="vv-caption">Nothing recorded yet.</p>
    <% end %>
  </section>
</div>

<div class="card" id="requests">
  <header>
    <h2>Privacy requests</h2>

    <p>
      Ask what we hold about you, correct something, or object to how we use it.
      We reply within 30 days. To export or delete your data, use
      <%= link_to "Account", settings_account_path, class: "text-forest underline-offset-4 hover:underline" %>.
    </p>
  </header>

  <section class="grid gap-6">
    <%= form_with model: @data_request, url: settings_privacy_requests_path, class: "form grid gap-4" do |form| %>
      <div class="grid gap-2">
        <%= form.label :kind, "What do you need?" %>
        <%= form.select :kind, [ [ "See what you hold about me", "access" ], [ "Correct something", "correction" ], [ "Object to how my data is used", "objection" ], [ "Something else", "other" ] ], {}, class: "select" %>
      </div>

      <div class="grid gap-2">
        <%= form.label :message, "Details" %>
        <%= form.text_area :message, required: true, rows: 4, maxlength: 5000, class: "textarea" %>
      </div>

      <div><%= form.submit "Send request", class: "btn-outline" %></div>
    <% end %>

    <% if @requests.any? %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>Asked</th>
              <th>Request</th>
              <th>Status</th>
              <th>Outcome</th>
            </tr>
          </thead>

          <tbody>
            <% @requests.each do |request| %>
              <tr>
                <td class="whitespace-nowrap">
                  <%= l request.created_at, format: :short %>
                </td>

                <td><%= request.kind.humanize %></td>

                <td>
                  <%= request.status.humanize %>

                  <% if request.open? %>
                    <span class="vv-caption">· reply by <%= l request.due_on, format: :short %></span>
                  <% end %>
                </td>

                <td><%= request.outcome %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>
