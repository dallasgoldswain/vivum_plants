<% content_for :title, "Reminders for several plants · VIVUM Plants" %>
<% back = @environment ? environment_path(@environment) : plants_path %>

<div class="grid gap-3">
  <%= link_to (@environment ? "← #{@environment.name}" : "← Collection"), back, class: "vv-kicker underline-offset-4 hover:underline" %>

  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="vv-kicker mb-2">New reminder</p>

      <h1 class="vv-h2">
        <%= @environment ? "Plants in #{@environment.name}" : "Several plants" %>
      </h1>
    </div>

    <%= help_link "reminders" %>
  </div>
</div>

<div class="card max-w-2xl">
  <header>
    <p>
      Each plant gets its own reminder, which you can change on its page later.
    </p>
  </header>

  <section>
    <% if @plants.empty? %>
      <p>
        No active plants
        <%= @environment ? "in #{@environment.name}" : "match" %>.
      </p>
    <% else %>
      <%= form_with model: @schedule, url: care_schedules_path, class: "form grid gap-4" do |form| %>
        <%= hidden_field_tag :environment_id, @environment&.id, id: nil %>

        <fieldset class="grid max-h-80 gap-1 overflow-y-auto">
          <legend class="vv-h4 mb-1">Plants</legend>

          <% @plants.each do |plant| %>
            <label class="flex min-h-11 items-center gap-2 text-sm font-normal">
              <%= check_box_tag "plant_ids[]", plant.id, @selected.include?(plant.id), id: "schedule_plant_#{plant.id}" %>

              <span>
                <%= plant.display_name %>
                <span class="vv-caption"><%= plant.record_id %></span>
              </span>
            </label>
          <% end %>
        </fieldset>

        <%= render "plants/care_schedules/fields", form: form, schedule: @schedule %>

        <fieldset class="grid gap-1">
          <legend class="mb-1 text-sm font-medium">
            If a plant already has this reminder
          </legend>

          <% { "leave_out" => "Leave that plant out", "keep" => "Add this one as well", "replace" => "Replace its reminder" }.each do |value, label| %>
            <label class="flex min-h-11 items-center gap-2 text-sm font-normal">
              <%= radio_button_tag :duplicate, value, value == "leave_out", id: "duplicate_#{value}" %>
              <%= label %>
            </label>
          <% end %>
        </fieldset>

        <div><%= form.submit "Set reminders", class: "btn" %></div>
      <% end %>

      <%= render "plants/care_events/suggestions", suggestions: CareEvent.suggestions_for(Current.user) %>
    <% end %>
  </section>
</div>
