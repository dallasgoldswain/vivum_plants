<% content_for :title, "Reset your password · VIVUM Plants" %>

<div>
  <p class="vv-kicker mb-2">Password</p>
  <h2 class="vv-h2">Forgot your password?</h2>

  <p class="vv-caption mt-2">
    Enter your email and we'll send you a link to choose a new one.
  </p>
</div>

<div class="card card-raised">
  <section>
    <%= form_with url: passwords_path, class: "form grid gap-6" do |form| %>
      <div class="grid gap-2">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
      </div>

      <%= form.submit "Email reset link", class: "btn w-full" %>
    <% end %>
  </section>
</div>

<p class="text-center text-sm">
  <%= link_to "Back to sign in", new_session_path, class: "text-forest underline-offset-4 hover:underline" %>
</p>
