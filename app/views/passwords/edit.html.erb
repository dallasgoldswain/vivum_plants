<% content_for :title, "Choose a new password · VIVUM Plants" %>

<div>
  <p class="vv-kicker mb-2">Password</p>
  <h2 class="vv-h2">Choose a new password</h2>
</div>

<div class="card card-raised">
  <section>
    <%= form_with url: password_path(params[:token]), method: :put, class: "form grid gap-6" do |form| %>
      <div class="grid gap-2">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", minlength: 12, maxlength: 72, aria: { describedby: "password-hint" } %>

        <p id="password-hint" class="vv-caption">At least 12 characters.</p>
      </div>

      <div class="grid gap-2">
        <%= form.label :password_confirmation, "Repeat new password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>

      <%= form.submit "Save password", class: "btn w-full" %>
    <% end %>
  </section>
</div>
