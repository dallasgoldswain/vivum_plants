<% content_for :title, "#{care_task_title(@care_task)} · #{subject_name(@care_task.subject)} · VIVUM Plants" %>

<div class="grid gap-3">
  <%= link_to "← Today", root_path, class: "vv-kicker underline-offset-4 hover:underline" %>

  <h1 class="vv-h2">
    <%= care_task_title(@care_task) %> <%= subject_name(@care_task.subject) %>
  </h1>

  <p class="vv-caption">
    <%= task_due_label(@care_task) %>. Every detail is optional.
  </p>
</div>

<div class="card max-w-xl">
  <section>
    <%= form_with model: @event, url: care_task_completion_path(@care_task), class: "form grid gap-3" do |form| %>
      <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>

      <% if @care_task.environment %>
        <%= render "environments/maintenance/fields", form: form, kind: (@care_task.kind == "custom" ? "glass_clean" : @care_task.kind) %>
        <%= render "environments/maintenance/suggestions", suggestions: @suggestions %>
      <% else %>
        <%= render "plants/care_events/fields", form: form, kind: (@care_task.kind == "custom" ? "pruning" : @care_task.kind) %>
        <%= render "plants/care_events/suggestions", suggestions: @suggestions %>
      <% end %>

      <div class="grid gap-2 sm:w-1/2">
        <%= form.label :occurred_at, "When" %>
        <%= form.datetime_local_field :occurred_at, value: Time.current.strftime("%Y-%m-%dT%H:%M"), max: Time.current.end_of_day.strftime("%Y-%m-%dT%H:%M") %>
      </div>

      <div class="flex flex-wrap gap-2">
        <%= form.submit "Done", class: "btn" %>
        <%= link_to "Cancel", root_path, class: "btn-ghost" %>
      </div>
    <% end %>
  </section>
</div>
