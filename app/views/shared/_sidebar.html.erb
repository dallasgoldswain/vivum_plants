<aside class="vv-sidebar vv-bg-sidebar vv-on-dark">
  <div class="mb-8"><%= render "shared/wordmark" %></div>

  <nav class="flex flex-1 flex-col gap-1" aria-label="Primary navigation">
    <%= render "shared/nav_items", link_class: "vv-nav-link" %>
  </nav>

  <div class="mt-4 flex flex-col gap-2 border-t border-white/10 pt-4">
    <% if Current.membership %>
      <p class="vv-nav-group mt-0">Working as</p>
      <p class="px-3 text-sm font-medium"><%= Current.seller.name %></p>
    <% end %>

    <p class="truncate px-3 text-xs font-semibold text-moss">
      <%= Current.user.email_address %>
    </p>

    <%= button_to "Sign out", session_path, method: :delete, class: "vv-sidebar-signout" %>
  </div>
</aside>
