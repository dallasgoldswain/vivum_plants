<% content_for :title, "New reminder · #{subject_name(@subject)} · VIVUM Plants" %>

<div class="grid gap-3">
  <%= link_to "← #{subject_name(@subject)}", polymorphic_path(@subject, anchor: "reminders"), class: "vv-kicker underline-offset-4 hover:underline" %>

  <div class="flex items-start justify-between gap-3">
    <h1 class="vv-h2">New reminder</h1>
    <%= help_link "reminders" %>
  </div>
</div>

<div class="card max-w-2xl">
  <section>
    <%= form_with model: @schedule, url: polymorphic_path([ @subject, :care_schedules ]), class: "form grid gap-4" do |form| %>
      <%= render "shared/form_errors", record: @schedule %>
      <%= render "schedules/fields", form: form, schedule: @schedule, subject: @subject %>

      <div class="flex flex-wrap gap-2">
        <%= form.submit "Set reminder", class: "btn" %>
        <%= link_to "Cancel", polymorphic_path(@subject, anchor: "reminders"), class: "btn-ghost" %>
      </div>
    <% end %>

    <%= render "plants/care_events/suggestions", suggestions: (@subject.is_a?(Environment) ? EnvironmentEvent : CareEvent).suggestions_for(Current.user) %>
  </section>
</div>
