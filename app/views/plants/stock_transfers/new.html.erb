<% content_for :title, "Move to stock · VIVUM Plants" %>

<div class="grid gap-3">
  <%= link_to "← #{@plant.display_name}", plant_path(@plant), class: "vv-kicker underline-offset-4 hover:underline" %>

  <div class="flex items-start justify-between gap-3">
    <h1 class="vv-h2">Move to <%= Current.seller.name %> stock</h1>
    <%= help_link "stock" %>
  </div>
</div>

<div class="card max-w-2xl">
  <header>
    <p>
      <%= @plant.display_name %> (<%= @plant.record_id %>) becomes a specimen in the
      business's stock, linked to this plant. Its history stays here, and its status
      changes to moved to stock. You can move it back while nothing is held.
    </p>
  </header>

  <section>
    <% if @locations.empty? %>
      <p>
        <%= Current.seller.name %> has no stock locations yet.
        <%= link_to "Add one", sell_stock_locations_path, class: "underline underline-offset-4" %> first.
      </p>
    <% else %>
      <%= form_with url: plant_stock_transfer_path(@plant), class: "form grid gap-3 sm:grid-cols-2" do |form| %>
        <div class="grid gap-2">
          <%= label_tag :location_id, "Location" %>
          <%= select_tag :location_id, options_for_select(location_options(@locations)), class: "select" %>
        </div>

        <div class="grid gap-2">
          <%= label_tag :price, "Price (R, optional)" %>
          <%= number_field_tag :price, nil, min: 0, step: "0.01", inputmode: "decimal" %>
        </div>

        <div><%= form.submit "Move to stock", class: "btn" %></div>
      <% end %>
    <% end %>
  </section>
</div>
