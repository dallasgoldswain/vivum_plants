<% content_for :title, "Edit reminder · #{@plant.display_name} · VIVUM Plants" %>

<div class="grid gap-3">
  <%= link_to "← #{@plant.display_name}", plant_path(@plant, anchor: "reminders"), class: "vv-kicker underline-offset-4 hover:underline" %>

  <h1 class="vv-h2">Edit reminder</h1>
</div>

<div class="card max-w-2xl">
  <section class="grid gap-3">
    <%= form_with model: @schedule, url: plant_care_schedule_path(@plant, @schedule), class: "form grid gap-4" do |form| %>
      <%= render "shared/form_errors", record: @schedule %>
      <%= render "plants/care_schedules/fields", form: form, schedule: @schedule %>

      <p class="vv-caption">
        Saving moves the next task to match, unless you changed its date
        yourself.
      </p>

      <div class="flex flex-wrap gap-2">
        <%= form.submit "Save", class: "btn" %>
        <%= link_to "Cancel", plant_path(@plant, anchor: "reminders"), class: "btn-ghost" %>
      </div>
    <% end %>
  </section>
</div>
