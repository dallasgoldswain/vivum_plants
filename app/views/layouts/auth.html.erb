<!DOCTYPE html>

<html lang="en-ZA">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-screen bg-linen">
    <div class="grid min-h-screen lg:grid-cols-[3fr_2fr]">
      <section
        class="vv-bg-auth hidden px-12 pt-16 pb-12 lg:block"
        aria-label="About VIVUM Plants"
      >
        <div class="mx-auto max-w-3xl">
          <div class="mb-10"><%= render "shared/wordmark" %></div>
          <h1 class="vv-h1 mb-4">Every plant. Every <em>detail</em>.</h1>

          <p class="vv-lead mb-10">
            Record your collection, its setups and care, and run your plant
            sales, from one place.
          </p>

          <div class="mb-14 grid grid-cols-3 gap-4">
            <% [ [ "Collection", "Plants, setups & care" ], [ "Selling", "Stock, auctions & orders" ], [ "Handover", "Care packs & QR labels" ] ].each do |kicker, title| %>
              <div
                class="
                  rounded-md border border-line bg-white/60 p-4
                  shadow-[0_8px_24px_rgba(26,51,36,0.06)]
                "
              >
                <p class="vv-kicker mb-1"><%= kicker %></p>
                <p class="vv-h4"><%= title %></p>
              </div>
            <% end %>
          </div>

          <hr class="vv-rule-organic">

          <p class="vv-caption">
            Made in South Africa, for indoor, aquatic, terrarium and tissue
            culture plants.
          </p>
        </div>
      </section>

      <main class="flex items-center justify-center px-6 py-12">
        <div class="grid w-full max-w-sm gap-6">
          <div class="lg:hidden"><%= render "shared/wordmark" %></div>
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
