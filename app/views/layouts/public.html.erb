<!DOCTYPE html>

<html lang="en-ZA">
  <head>
    <%= render "layouts/head" %>
    <meta name="robots" content="noindex, nofollow">
  </head>

  <body class="vv-bg-auth min-h-screen">
    <main class="mx-auto grid max-w-3xl gap-6 px-4 py-10 sm:px-6">
      <div><%= render "shared/wordmark" %></div>

      <%= yield %>

      <p class="vv-caption text-center">
        Shared from VIVUM Plants ·
        <%= link_to "Privacy notice", legal_privacy_path, class: "underline-offset-4 hover:underline" %>
      </p>
    </main>
  </body>
</html>
