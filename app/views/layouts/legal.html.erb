<!DOCTYPE html>

<html lang="en-ZA">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="vv-bg-auth min-h-screen">
    <main class="mx-auto grid max-w-3xl gap-8 px-4 py-10 sm:px-6">
      <div><%= render "shared/wordmark" %></div>

      <% unless content_for?(:help_page) %>
        <div class="alert" role="note">
          <h2>Draft for the pilot, pending legal review</h2>

          <section>
            This is a plain-language first version for pilot users. It will be
            replaced by a reviewed version, and you'll be asked to accept that
            one.
          </section>
        </div>
      <% end %>

      <article class="vv-legal card card-raised">
        <section class="grid gap-4">
          <%= yield %>
        </section>
      </article>

      <p class="vv-caption text-center">
        <%= link_to "Terms of use", legal_terms_path, class: "underline-offset-4 hover:underline" %>
        ·
        <%= link_to "Seller terms", legal_seller_terms_path, class: "underline-offset-4 hover:underline" %>
        ·
        <%= link_to "Privacy notice", legal_privacy_path, class: "underline-offset-4 hover:underline" %>
      </p>
    </main>
  </body>
</html>
