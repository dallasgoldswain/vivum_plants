<!DOCTYPE html>

<html lang="en-ZA">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="vv-bg-app min-h-screen">
    <% if app_shell? %>
      <%= render "shared/sidebar" %>
      <main class="vv-main">
        <div class="vv-content grid gap-6">
          <div class="md:hidden"><%= render "shared/wordmark" %></div>
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </main>
      <%= render "shared/bottom_nav" %>
    <% else %>
      <main class="mx-auto grid max-w-xl gap-6 px-4 py-10">
        <%= render "shared/wordmark" %>
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
