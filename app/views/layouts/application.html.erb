<!DOCTYPE html>

<html lang="en-ZA">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="vv-bg-app min-h-screen" <%= tag.attributes(data: { controller: "offline-sync", offline_sync_user_id_value: Current.user.id }) if app_shell? %>>
    <% if app_shell? %>
      <%= render "shared/sidebar" %>
      <main class="vv-main">
        <div class="vv-content grid gap-6">
          <div class="flex items-center justify-between gap-3 md:hidden">
            <%= render "shared/wordmark" %>

            <nav class="vv-top-links" aria-label="Support">
              <%= render "shared/help_links", link_class: nil %>
            </nav>
          </div>

          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </main>
      <%= render "shared/bottom_nav" %>
    <% else %>
      <main class="mx-auto grid max-w-xl gap-6 px-4 py-10">
        <%= render "shared/wordmark" %>
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
