<% content_for :title, "Apply guidance defaults · VIVUM Plants" %>

<div class="grid gap-3">
  <%= link_to "← Collection", plants_path, class: "vv-kicker underline-offset-4 hover:underline" %>

  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="vv-kicker mb-2">Guidance</p>
      <h1 class="vv-h2">Apply current defaults</h1>
    </div>

    <%= help_link "guidance-settings" %>
  </div>
</div>

<div class="card max-w-2xl">
  <header>
    <h2>Your defaults</h2>

    <p>
      <%= guidance_switches.map { |key, label| "#{label} #{on_off(@defaults.public_send(key)).downcase}" }.join(" · ") %>.
      Only the guidance switches change; reminders and history stay as they are.
    </p>
  </header>

  <section class="grid gap-4">
    <% if @plants.empty? %>
      <p>No plants match.</p>
    <% else %>
      <p role="status">
        <% if @behind.empty? %>
          All <%= pluralize(@plants.size, "plant") %> already match your
          defaults.
        <% else %>
          <%= @behind.size %> of <%= pluralize(@plants.size, "plant") %> don't
          match your defaults and are ticked.
        <% end %>
      </p>

      <%= form_with url: guidance_applications_path, class: "form grid gap-3" do |form| %>
        <fieldset class="grid max-h-96 gap-1 overflow-y-auto">
          <legend class="vv-h4 mb-1">Plants</legend>

          <% @plants.each do |plant| %>
            <% status = plant.guidance_status(@defaults) %>
            <% changes = guidance_changes(plant, @defaults) %>

            <label class="flex min-h-11 items-start gap-2 text-sm font-normal">
              <%= check_box_tag "plant_ids[]", plant.id, @behind.include?(plant.id), id: "guidance_plant_#{plant.id}", class: "mt-1" %>

              <span class="grid">
                <span>
                  <%= plant.display_name %>
                  <span class="vv-caption"><%= plant.record_id %></span>
                </span>

                <span class="vv-caption">
                  <%= guidance_status_label(status) %><%= changes.any? ? " · #{changes.join(', ')}" : "" %>
                </span>
              </span>
            </label>
          <% end %>
        </fieldset>

        <div><%= form.submit "Apply to chosen plants", class: "btn" %></div>
      <% end %>
    <% end %>
  </section>
</div>
