<h1>Create your account</h1>

<%= render "shared/flash" %>

<% if @user.errors.any? %>
  <ul role="alert" style="color:red">
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user, url: registration_path do |form| %>
  <div>
    <%= form.label :email_address %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %>
  </div>

  <div>
    <%= form.label :password, "Password (at least 12 characters)" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72 %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Repeat password" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <%= form.submit "Create account" %>
<% end %>

<p><%= link_to "Already have an account? Sign in", new_session_path %></p>
