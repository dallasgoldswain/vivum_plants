<% content_for :title, "Create your account · VIVUM Plants" %>

<div>
  <p class="vv-kicker mb-2">Free for collectors</p>
  <h2 class="vv-h2">Create your account</h2>
</div>

<% if @user.errors.any? %>
  <div class="alert-destructive" role="alert">
    <h2>We couldn't create your account</h2>

    <section>
      <ul class="list-disc pl-4">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  </div>
<% end %>

<div class="card card-raised">
  <section>
    <%= form_with model: @user, url: registration_path, class: "form grid gap-6" do |form| %>
      <div class="grid gap-2">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %>
      </div>

      <div class="grid gap-2">
        <%= form.label :password %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72, aria: { describedby: "password-hint" } %>

        <p id="password-hint" class="vv-caption">At least 12 characters.</p>
      </div>

      <div class="grid gap-2">
        <%= form.label :password_confirmation, "Repeat password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>

      <%= form.submit "Create account", class: "btn w-full" %>
    <% end %>
  </section>
</div>

<p class="text-center text-sm text-fg2">
  Already have an account?
  <%= link_to "Sign in", new_session_path, class: "text-forest underline-offset-4 hover:underline" %>
</p>
