<%# One kind of care on Today (D115): tick plants and choose Done, or skip or snooze one. %>
<% form_id = "done-#{section}-#{tasks.first.id}" %>

<div class="card">
  <header>
    <h3 class="vv-h3">
      <%= care_task_title(tasks.first) %> ·
      <%= pluralize(tasks.size, "plant") %>
    </h3>
  </header>

  <section class="grid gap-2">
    <ul class="grid gap-2">
      <% tasks.each do |task| %>
        <li class="grid gap-2 rounded-[4px] border border-line bg-linen px-3 py-2">
          <div class="flex items-start gap-3">
            <%= check_box_tag "task_ids[]", task.id, true, id: "task_#{section}_#{task.id}", form: form_id, class: "mt-1", aria: { label: "Include #{task.plant.display_name}" } %>

            <div class="grid min-w-0 flex-1 gap-0.5">
              <%= link_to task.plant.display_name, plant_path(task.plant, anchor: "reminders"), class: "font-medium underline-offset-4 hover:underline" %>

              <span class="vv-caption">
                <%= [ task.plant.record_id, task_due_label(task), task.note ].compact.join(" · ") %>
              </span>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-1">
            <%= link_to "Done with details…", new_care_task_completion_path(task), class: "btn-sm-ghost" %>

            <%= form_with url: care_task_skip_path(task), data: { controller: "offline-form", offline_form_subject_value: "today", offline_form_label_value: "Skip #{care_task_title(task).downcase} · #{task.plant.display_name}", action: "submit->offline-form#submit" } do |form| %>
              <%= hidden_field_tag :idempotency_key, SecureRandom.uuid, id: nil, data: { offline_form_target: "key" } %>
              <%= form.button "Skip", class: "btn-sm-ghost", data: { offline_form_target: "submit" } %>

              <span
                class="vv-caption"
                data-offline-form-target="status"
                role="status"
              ></span>
            <% end %>

            <details>
              <summary class="btn-sm-ghost">Snooze</summary>

              <div class="mt-2 flex flex-wrap items-center gap-1">
                <% { "tomorrow" => "Tomorrow", "3" => "3 days" }.each do |value, label| %>
                  <%= form_with url: care_task_snooze_path(task), data: { controller: "offline-form", offline_form_subject_value: "today", offline_form_label_value: "Snooze #{care_task_title(task).downcase} · #{task.plant.display_name} · #{label.downcase}", action: "submit->offline-form#submit" } do |form| %>
                    <%= hidden_field_tag :idempotency_key, SecureRandom.uuid, id: nil, data: { offline_form_target: "key" } %>
                    <%= hidden_field_tag :until, value, id: nil %>
                    <%= form.button label, class: "btn-sm-outline", data: { offline_form_target: "submit" } %>

                    <span
                      class="vv-caption"
                      data-offline-form-target="status"
                      role="status"
                    ></span>
                  <% end %>
                <% end %>

                <%= form_with url: care_task_snooze_path(task), class: "flex items-center gap-1", data: { controller: "offline-form", offline_form_subject_value: "today", offline_form_label_value: "Snooze #{care_task_title(task).downcase} · #{task.plant.display_name}", action: "submit->offline-form#submit" } do |form| %>
                  <%= hidden_field_tag :idempotency_key, SecureRandom.uuid, id: nil, data: { offline_form_target: "key" } %>
                  <%= label_tag "snooze_#{section}_#{task.id}", "Until", class: "sr-only" %>
                  <%= date_field_tag :until_date, Date.current + 1, id: "snooze_#{section}_#{task.id}", min: Date.current + 1, class: "input w-auto", data: { offline_form_target: "content", summary_label: "until" } %>
                  <%= form.button "Snooze", class: "btn-sm-outline", data: { offline_form_target: "submit" } %>

                  <span
                    class="vv-caption"
                    data-offline-form-target="status"
                    role="status"
                  ></span>
                <% end %>
              </div>
            </details>
          </div>
        </li>
      <% end %>
    </ul>

    <%= form_with url: task_completions_path, id: form_id, data: { controller: "offline-form", offline_form_subject_value: "today", offline_form_label_value: "#{care_task_title(tasks.first)} done", action: "submit->offline-form#submit" } do |form| %>
      <%= hidden_field_tag :idempotency_key, SecureRandom.uuid, id: nil, data: { offline_form_target: "key" } %>

      <div class="flex flex-wrap items-center gap-2">
        <%= form.button "Done for ticked plants", class: (section == "due" ? "btn" : "btn-outline"), data: { offline_form_target: "submit" } %>

        <span
          class="vv-caption"
          data-offline-form-target="status"
          role="status"
        ></span>
      </div>
    <% end %>
  </section>
</div>
