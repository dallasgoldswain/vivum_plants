<% today = capability?("care.reminders") %>

<div>
  <p class="vv-kicker mb-2"><%= l(Date.current, format: "%A %-d %B") %></p>

  <div class="flex items-start justify-between gap-3">
    <h1 class="vv-h2"><%= today ? "Today" : "Welcome to VIVUM Plants" %></h1>
    <%= help_link(today ? "today" : "getting-started") %>
  </div>

  <p class="vv-caption mt-1">Signed in as <%= Current.user.email_address %>.</p>
</div>

<hr class="vv-rule-organic my-0">

<% if @library_choice %>
  <div class="card max-w-2xl" id="library-choice">
    <header>
      <h2>Use library care suggestions?</h2>

      <p>
        Plants linked to a profile in your library can suggest reminders and
        show care notes. Nothing is added until you accept it. You can change
        this any time in Account → Guidance settings.
      </p>
    </header>

    <footer class="flex flex-wrap gap-2">
      <%= button_to "Yes, use them", library_choice_path, params: { use_library: "1" }, class: "btn" %>
      <%= button_to "Not now", library_choice_path, params: { use_library: "0" }, class: "btn-outline" %>
    </footer>
  </div>
<% end %>

<% if @suggestion_plants&.any? %>
  <section
    class="grid gap-2"
    id="library-suggestions"
    aria-labelledby="library-suggestions-title"
  >
    <h2 class="vv-h4" id="library-suggestions-title">Suggestions to review</h2>

    <p>
      <%= safe_join(@suggestion_plants.map { link_to(it.display_name, plant_path(it, anchor: "guidance"), class: "underline underline-offset-4") }, ", ") %>
    </p>
  </section>
<% end %>

<% if today %>
  <section class="grid gap-4" id="today" aria-labelledby="today-due">
    <h2 class="vv-h3" id="today-due">Due now</h2>

    <% if @due_groups.any? %>
      <div class="grid gap-4 lg:grid-cols-2">
        <% @due_groups.each do |tasks| %>
          <%= render "home/task_group", tasks: tasks, section: "due" %>
        <% end %>
      </div>
    <% else %>
      <p class="vv-caption">
        Nothing due. Reminders you set on a plant's page show up here.
      </p>
    <% end %>

    <div
      class="grid gap-2"
      data-controller="offline-queue-list"
      data-offline-queue-list-subject-value="today"
      hidden
    >
      <h3 class="vv-h4">Waiting to send</h3>
      <ul class="grid gap-2" data-offline-queue-list-target="list"></ul>
    </div>

    <% if @upcoming_groups.any? %>
      <details>
        <summary class="vv-h4 cursor-pointer">
          Next 7 days · <%= pluralize(@upcoming_groups.sum(&:size), "task") %>
        </summary>

        <div class="mt-3 grid gap-4 lg:grid-cols-2">
          <% @upcoming_groups.each do |tasks| %>
            <%= render "home/task_group", tasks: tasks, section: "upcoming" %>
          <% end %>
        </div>
      </details>
    <% end %>

    <% if @snoozed.any? %>
      <details>
        <summary class="vv-caption cursor-pointer underline underline-offset-4">
          Snoozed · <%= @snoozed.size %>
        </summary>

        <ul class="mt-2 grid gap-1 text-sm">
          <% @snoozed.each do |task| %>
            <li>
              <%= care_task_title(task) %> ·
              <%= link_to subject_name(task.subject), polymorphic_path(task.subject, anchor: "reminders"), class: "underline underline-offset-4" %>:
              until <%= l(task.snoozed_until, format: :long) %>
              (<%= task_due_label(task).downcase %>)
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </section>

  <hr class="vv-rule-organic my-0">
<% end %>

<div class="grid gap-6 lg:grid-cols-2">
  <% if @invitations.any? %>
    <div class="card">
      <header>
        <p class="vv-kicker">Invites</p>
        <h2>You're invited</h2>
      </header>

      <section>
        <ul class="grid gap-2">
          <% @invitations.each do |invitation| %>
            <li
              class="
                flex min-h-11 items-center justify-between gap-3 rounded-[4px]
                border border-line bg-linen px-3 py-2
              "
            >
              <span class="font-medium"><%= invitation.business_label %></span>
              <%= link_to "View invite", invitation_path(invitation.acceptance_token), class: "btn-sm-outline" %>
            </li>
          <% end %>
        </ul>
      </section>
    </div>
  <% end %>

  <% if @memberships.any? %>
    <div class="card">
      <header>
        <p class="vv-kicker">Selling</p>
        <h2>Seller businesses</h2>
      </header>

      <section>
        <ul class="grid gap-2">
          <% @memberships.each do |membership| %>
            <li
              class="
                flex min-h-11 items-center justify-between gap-3
                rounded-[4px] border border-line bg-linen px-3 py-2
              "
            >
              <span>
                <span class="font-medium"><%= membership.seller.name %></span>
                <span class="badge-outline ml-2"><%= membership.role.humanize %></span>
              </span>

              <% if membership == Current.membership %>
                <span class="badge-secondary">Current</span>
              <% else %>
                <%= button_to "Work as this business", current_seller_path, method: :patch, params: { seller_id: membership.seller_id }, class: "btn-sm-outline" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    </div>
  <% end %>

  <div class="card">
    <header>
      <p class="vv-kicker">Account security</p>
      <h2>Two-step sign-in</h2>

      <p>
        <%= Current.user.two_factor_enabled? ? "On. You'll be asked for a code from your authenticator app when you sign in." : "Off. Add a second step to protect your account." %>
      </p>
    </header>

    <% if Current.user.two_factor_enabled? %>
      <section class="grid gap-6">
        <%= form_with url: two_factor_backup_codes_path, class: "form grid gap-2" do |form| %>
          <%= form.label :code, "Current code", for: "backup_code_regenerate" %>

          <div class="flex gap-2">
            <%= form.text_field :code, id: "backup_code_regenerate", required: true, autocomplete: "one-time-code", class: "font-mono" %>
            <%= form.submit "Replace backup codes", class: "btn-outline" %>
          </div>
        <% end %>

        <% unless Current.user.two_factor_required? %>
          <%= form_with url: two_factor_enrolment_path, method: :delete, class: "form grid gap-2" do |form| %>
            <%= form.label :code, "Current code", for: "two_factor_disable" %>

            <div class="flex gap-2">
              <%= form.text_field :code, id: "two_factor_disable", required: true, autocomplete: "one-time-code", class: "font-mono" %>
              <%= form.submit "Turn off", class: "btn-destructive" %>
            </div>
          <% end %>
        <% end %>
      </section>
    <% else %>
      <footer>
        <%= link_to "Set up two-step sign-in", new_two_factor_enrolment_path, class: "btn" %>
      </footer>
    <% end %>
  </div>
</div>
